[Unit]
Description=Trading Buddy - Live Signal Poster (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pklprasanth522
WorkingDirectory=/home/pklprasanth522/Trading-Buddy
EnvironmentFile=/home/pklprasanth522/Trading-Buddy/.env
ExecStart=/home/pklprasanth522/Trading-Buddy/.venv/bin/python scripts/live_signal_poster.py
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/pklprasanth522/Trading-Buddy

[Install]
WantedBy=multi-user.target
