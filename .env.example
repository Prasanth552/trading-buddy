# Copy to .env and fill in. NEVER commit .env.
KITE_API_KEY=
KITE_API_SECRET=
# Optional — only for automated daily login (else run `python main.py --login` each morning).
# Storing your Zerodha password here is sensitive; leave blank to use manual login.
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Upstox — execution only (data stays on Kite). Sandbox token = 30-day, dummy orders.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_SANDBOX_TOKEN=
# Web dashboard (set a password before exposing it beyond your home Wi-Fi).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8000
